# ============================================================
# EvoQuant-AI environment template — copy to .env and fill in
# ============================================================

# Google AI Studio API key. This is the ONLY LLM setting required from the
# environment: the model ids (gemma-4-31b-it + gemma-4-26b-a4b-it fallback) and
# the native generateContent endpoint are hardcoded in config.py.
GEMINI_API_KEY=your_actual_google_ai_studio_key_here

# --- LLM resilience (optional) ---
# Adaptive model health: after this many consecutive hard failures (e.g. the
# primary repeatedly returning HTTP 500) the model is sidelined for
# GEMINI_MODEL_COOLDOWN_SECONDS and the chain uses the fallback directly. It is
# retried after the cooldown and restored on its first successful answer.
GEMINI_MODEL_FAILURE_THRESHOLD=3
GEMINI_MODEL_COOLDOWN_SECONDS=600

# --- PostgreSQL / TimescaleDB (REQUIRED) ---
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=evoquant_db
POSTGRES_USER=evoquant
POSTGRES_PASSWORD=change_me_to_a_strong_password

# --- Redis (REQUIRED password; datastore is not publicly exposed) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_to_a_strong_password

# --- Broker execution (Alpaca paper) ---
ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Per-agent paper sub-accounts (JSON). Each evolutionary agent trades an
# isolated book. Omitted agents fall back to the shared account above.
# ALPACA_SUBACCOUNTS={"Agent_Alpha":{"key":"K1","secret":"S1"},"Agent_Beta":{"key":"K2","secret":"S2"}}

# --- Safety / behavior flags ---
# SHADOW_MODE computes decisions but submits no broker orders.
SHADOW_MODE=false
SENTIMENT_ENABLED=true
HEADLINES_ENABLED=true
REGIME_SCALER_ENABLED=true

# --- Risk controls ---
MAX_POSITION_CAP=0.05
MAX_GROSS_EXPOSURE=1.00
MAX_NET_EXPOSURE=0.60
MAX_SECTOR_EXPOSURE=0.30
CVAR_BUDGET=0.04
STOP_LOSS_PCT=0.025
TAKE_PROFIT_PCT=0.050
SESSION_DRAWDOWN_PCT=0.05
