# .rooignore - Files and directories ignored by Roo Code

# Version control
.git/

# Environment variables & sensitive credentials
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cert
credentials.json
secrets.json
.streamlit/secrets.toml

# Virtual environments
.venv/
venv/
env/
ENV/

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Databases & local stores
*.db
*.sqlite
*.sqlite3

# Large binary files, datasets, and model checkpoints
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.pt
*.pth
*.bin
*.onnx

# Logs and temporary files
*.log
logs/
*.tmp
*.temp

# IDEs and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
